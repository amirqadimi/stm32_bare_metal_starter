{
	"version": 8,
	"configurePresets": [
		{
			"name": "default",
			"displayName": "Default",
			"hidden": true,
			"generator": "Ninja",
			"toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
			"cacheVariables": {
			}
		},
		{
			"name": "debug-h723",
			"displayName": "Debug STM32H723",
			"inherits": "default",
			"binaryDir": "${sourceDir}/build-h723",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"MCU_TYPE": "stm32h723"
			}
		},
		{
			"name": "release-h723",
			"displayName": "Release STM32H723",
			"inherits": "default",
			"binaryDir": "${sourceDir}/build-h723",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"MCU_TYPE": "stm32h723"
			}
		},
		{
			"name": "debug-h7b0",
			"displayName": "Debug STM32H7B0",
			"inherits": "default",
			"binaryDir": "${sourceDir}/build-h7b0",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"MCU_TYPE": "stm32h7b0"
			}
		},
		{
			"name": "release-h7b0",
			"displayName": "Release STM32H7B0",
			"inherits": "default",
			"binaryDir": "${sourceDir}/build-h7b0",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"MCU_TYPE": "stm32h7b0"
			}
		}
	],
	"buildPresets": [
		{
			"name": "build-debug-h723",
			"displayName": "Build Debug STM32H723",
			"configurePreset": "debug-h723"
		},
		{
			"name": "build-release-h723",
			"displayName": "Build Release STM32H723",
			"configurePreset": "release-h723"
		},
		{
			"name": "build-debug-h7b0",
			"displayName": "Build Debug STM32H7B0",
			"configurePreset": "debug-h7b0"
		},
		{
			"name": "build-release-h7b0",
			"displayName": "Build Release STM32H7B0",
			"configurePreset": "release-h7b0"
		}
	]
}
